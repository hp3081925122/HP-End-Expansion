{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "hp_end_expansion:tide_crossbow_pull",
      "fallback": {
        "type": "minecraft:model",
        "model": "hp_end_expansion:item/tide_crossbow_pulling_0"
      },
      "entries": [
        {
          "threshold": 0.65,
          "model": {
            "type": "minecraft:model",
            "model": "hp_end_expansion:item/tide_crossbow_pulling_1"
          }
        },
        {
          "threshold": 0.9,
          "model": {
            "type": "minecraft:model",
            "model": "hp_end_expansion:item/tide_crossbow_pulling_2"
          }
        }
      ]
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "arrow",
          "model": {
            "type": "minecraft:model",
            "model": "hp_end_expansion:item/tide_crossbow_arrow"
          }
        },
        {
          "when": "rocket",
          "model": {
            "type": "minecraft:model",
            "model": "hp_end_expansion:item/tide_crossbow_firework"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "hp_end_expansion:item/tide_crossbow"
      }
    }
  }
}
